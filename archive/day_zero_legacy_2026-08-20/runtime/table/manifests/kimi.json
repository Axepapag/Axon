{
  "client_id": "kimi",
  "display_name": "Kimi K3",
  "wake": {
    "argv": ["kimi", "--model", "kimi-code/k3", "--agent", "axon-swarm-lead", "-p", "{prompt}"],
    "resume_argv": ["kimi", "--session", "{session_id}", "-p", "{prompt}"],
    "prompt_via": "argv",
    "timeout_seconds": 1800,
    "workdir": "D:\\Axon"
  },
  "session": {
    "parse_regex": "To resume this session: kimi (?:-r|--session) (session_[a-z0-9-]+)"
  },
  "capabilities": ["coding", "architecture_review", "subagents", "swarm", "k3"],
  "identity_stamp": "Kimi / K3 default / Kimi Code CLI 0.36.1 / 2026-08-20",
  "enabled": true,
  "notes": "Project agents live under .agents/agents. K3 is the default swarm lead; ChatGPT verifies diffs/tests and owns commit/push/ledger publication."
}
